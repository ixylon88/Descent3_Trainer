<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--<ApplicationIcon>..\..\pics\d3_orb__2006+2.ico</ApplicationIcon>-->
    <AssemblyName>D3SaveEditor</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Descent 3 Savegame Editor</AssemblyTitle>
    <Description>Offline editor for Descent 3 savegames</Description>
    <Product>Descent 3 Savegame Editor</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\D3SaveEditor.Core\D3SaveEditor.Core.csproj" />
    <InternalsVisibleTo Include="D3SaveEditor.Tests" />
  </ItemGroup>

  <!-- build: put the images listed here in the respective folder -->
  <!-- run: if you simply want to use the artifact (executable), put the images in the folder where the executable is located  -->
  <ItemGroup>
    <Content Include="..\..\pics\Anim?.bmp" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="..\..\pics\flashmen_?.jpg" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="..\..\pics\SETU?.BMP" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
