<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--<ApplicationIcon>..\..\pics\d3_orb__2006+2.ico</ApplicationIcon>-->
    <AssemblyName>D3SaveEditor</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Descent 3 Savegame Editor</AssemblyTitle>
    <Description>Offline editor for Descent 3 savegames</Description>
    <Product>Descent 3 Savegame Editor</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\D3SaveEditor.Core\D3SaveEditor.Core.csproj" />
  </ItemGroup>

