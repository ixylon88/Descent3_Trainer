<Window x:Class="D3SaveEditor.Gui.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:D3SaveEditor.Gui"
        Title="Descent 3 · Savegame Editor" Width="920" Height="760"
        MinWidth="900" MinHeight="760" WindowStartupLocation="CenterScreen"
        Background="#F3F6FA" Foreground="#152438" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" Closing="OnClosing">
    <Window.Resources>
        <gui:LocalizationService x:Key="Localization" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="NumericInput" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,2,8,4" />
        </Style>

        <DataTemplate x:Key="WeaponRowTemplate">
            <Grid Margin="0,2" MinHeight="29">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="154" />
                </Grid.ColumnDefinitions>
                <CheckBox HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                          IsChecked="{Binding Owned, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                <TextBox Grid.Column="2" Style="{StaticResource NumericInput}"
                         AutomationProperties.Name="{Binding AmmoLabel}"
                         IsEnabled="{Binding CanEditAmmo}" Text="{Binding Ammo, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3" Content="Max" IsEnabled="{Binding CanEditAmmo}" Click="OnMaxWeapon" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="6,0" Text="{Binding Limit}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WeaponTabTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <Label Style="{StaticResource ValueLabel}" Content="{Binding ActiveLabel}"
                               Target="{Binding ElementName=ActiveWeapon}" />
                        <ComboBox x:Name="ActiveWeapon" MinWidth="230" ItemsSource="{Binding Choices}"
                                  SelectedIndex="{Binding SelectedIndex, Mode=OneWay}"
                                  SelectionChanged="OnActiveWeaponChanged" />
                    </DockPanel>
                    <Grid Background="#E8EEF6" MinHeight="28" Margin="0,0,0,4" TextBlock.FontWeight="SemiBold">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="154" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding [Present], Source={StaticResource Localization}, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding NameHeading}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CountHeading}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="6,0" Text="{Binding LimitHeading}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource WeaponRowTemplate}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{Binding [SelectAll], Source={StaticResource Localization}, Mode=OneWay}" Click="OnSelectWeapons" />
                        <Button Content="{Binding [ClearAll], Source={StaticResource Localization}, Mode=OneWay}" Click="OnClearWeapons" />
                        <Button Content="{Binding MaxPresentLabel}" Click="OnMaxShipWeapons" />
                        <Button Content="{Binding [FillStorage], Source={StaticResource Localization}, Mode=OneWay}" Click="OnMaxStorageWeapons" Visibility="{Binding StorageMaximumVisibility}" />
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Hint}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ExtraEntries}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate x:Key="SupplyRowTemplate">
            <DockPanel Margin="0,1">
                <TextBox x:Name="SupplyCount" DockPanel.Dock="Right" Width="74" Margin="4,0,0,4"
                         Style="{StaticResource NumericInput}" ToolTip="{Binding Hint}"
                         IsEnabled="{Binding CanEdit}" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                <Label Style="{StaticResource ValueLabel}" Content="{Binding Item.Name}"
                       Target="{Binding ElementName=SupplyCount}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShipRowTemplate">
            <CheckBox Content="{Binding Label}" IsEnabled="{Binding CanUnlock}"
                      IsChecked="{Binding Allowed, Mode=TwoWay}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,6">
            <Button Content="{Binding [OpenSave], Source={StaticResource Localization}, Mode=OneWay}" Click="OnChooseOpen" />
            <Button x:Name="SaveButton" Content="{Binding [SaveAndBackup], Source={StaticResource Localization}, Mode=OneWay}" Click="OnSave" IsEnabled="False" />
            <Button x:Name="CopyButton" Content="{Binding [SaveCopy], Source={StaticResource Localization}, Mode=OneWay}" Click="OnSaveCopy" IsEnabled="False" />
            <Button x:Name="ResetButton" Content="{Binding [ResetValues], Source={StaticResource Localization}, Mode=OneWay}" Click="OnReset" IsEnabled="False" />
            <Button Content="{Binding [LoadShipLimits], Source={StaticResource Localization}, Mode=OneWay}" Click="OnLoadLimits"
                    ToolTip="{Binding [LoadShipLimitsTip], Source={StaticResource Localization}, Mode=OneWay}" />
            <Button x:Name="LanguageButton" Content="{Binding [Language], Source={StaticResource Localization}, Mode=OneWay}" Click="OnOpenLanguageMenu"
                    ToolTip="{Binding [LanguageTip], Source={StaticResource Localization}, Mode=OneWay}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Deutsch" Tag="de" IsCheckable="True" Click="OnSelectLanguage" />
                        <MenuItem Header="_English" Tag="en" IsCheckable="True" Click="OnSelectLanguage" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>

        <Border Grid.Row="1" Background="#152438" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <Image DockPanel.Dock="Right" MaxWidth="150" MaxHeight="48" Margin="-11,-11" VerticalAlignment="Center"
                       Stretch="Uniform" ImageFailed="Image_ImageFailed" IsHitTestVisible="False">
                    <Image.Source>
                        <BitmapImage DecodePixelWidth="200" UriSource="flashmen_1.jpg" />
                    </Image.Source>
                </Image>
                <StackPanel>
                    <TextBlock x:Name="SaveTitle" Text="{Binding [NoSave], Source={StaticResource Localization}, Mode=OneWay}"
                               FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SaveDetails" Margin="0,3,0,0" Foreground="#CFDCEA"
                               Text="{Binding [OpenHint], Source={StaticResource Localization}, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="EditorTabs" Grid.Row="2">
            <TabItem Header="{Binding [PlayerTab], Source={StaticResource Localization}, Mode=OneWay}">
                <ScrollViewer x:Name="PlayerEditor" IsEnabled="False" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Header="{Binding [PlayerSupplies], Source={StaticResource Localization}, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Style="{StaticResource ValueLabel}" Content="{Binding [Energy], Source={StaticResource Localization}, Mode=OneWay}" Target="{Binding ElementName=EnergyInput}" />
                                <TextBox x:Name="EnergyInput" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Button Grid.Column="2" Content="Max 200" Click="OnMaxEnergy" />
                                <Label Grid.Row="1" Style="{StaticResource ValueLabel}" Content="{Binding [Shields], Source={StaticResource Localization}, Mode=OneWay}" Target="{Binding ElementName=ShieldsInput}" />
                                <TextBox x:Name="ShieldsInput" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Max 200" Click="OnMaxShields" />
                                <Label Grid.Row="2" Style="{StaticResource ValueLabel}" Content="{Binding [AfterburnerSeconds], Source={StaticResource Localization}, Mode=OneWay}" Target="{Binding ElementName=AfterburnerInput}" />
                                <TextBox x:Name="AfterburnerInput" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Button Grid.Row="2" Grid.Column="2" Content="{Binding [FillAfterburner], Source={StaticResource Localization}, Mode=OneWay}" Click="OnMaxAfterburner" />
                                <Label Grid.Row="3" Style="{StaticResource ValueLabel}" Content="{Binding [Lives], Source={StaticResource Localization}, Mode=OneWay}" Target="{Binding ElementName=LivesInput}" />
                                <TextBox x:Name="LivesInput" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Label Grid.Row="4" Style="{StaticResource ValueLabel}" Content="{Binding [Score], Source={StaticResource Localization}, Mode=OneWay}" Target="{Binding ElementName=ScoreInput}" />
                                <TextBox x:Name="ScoreInput" Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="{Binding [Effects], Source={StaticResource Localization}, Mode=OneWay}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="GodRenewButton" DockPanel.Dock="Right" Content="{Binding [ExtendEffect], Source={StaticResource Localization}, Mode=OneWay}" Click="OnRenewEffect" Tag="{Binding ElementName=GodModeInput}"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding [ExtendEffectTip], Source={StaticResource Localization}, Mode=OneWay}" />
                                    <CheckBox x:Name="GodModeInput" Content="{Binding [Invulnerability], Source={StaticResource Localization}, Mode=OneWay}"
                                              Checked="OnEffectChanged" Unchecked="OnEffectChanged"
                                              ToolTip="{Binding [InvulnerabilityTip], Source={StaticResource Localization}, Mode=OneWay}" />
                                </DockPanel>
                                <TextBlock x:Name="GodTime" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <DockPanel>
                                    <Button x:Name="CloakRenewButton" DockPanel.Dock="Right" Content="{Binding [ExtendEffect], Source={StaticResource Localization}, Mode=OneWay}" Click="OnRenewEffect" Tag="{Binding ElementName=CloakInput}"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding [ExtendEffectTip], Source={StaticResource Localization}, Mode=OneWay}" />
                                    <CheckBox x:Name="CloakInput" Content="{Binding [Cloak], Source={StaticResource Localization}, Mode=OneWay}" Checked="OnEffectChanged" Unchecked="OnEffectChanged"
                                              ToolTip="{Binding [CloakTip], Source={StaticResource Localization}, Mode=OneWay}" />
                                </DockPanel>
                                <TextBlock x:Name="CloakTime" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="{Binding [Equipment], Source={StaticResource Localization}, Mode=OneWay}">
                            <StackPanel>
                                <CheckBox x:Name="CoolerInput" Content="{Binding [Cooler], Source={StaticResource Localization}, Mode=OneWay}" Checked="OnEffectChanged" Unchecked="OnEffectChanged" />
                                <CheckBox x:Name="ConverterInput" Content="{Binding [Converter], Source={StaticResource Localization}, Mode=OneWay}" Checked="OnEffectChanged" Unchecked="OnEffectChanged" />
                                <CheckBox x:Name="QuadInput" Content="{Binding [QuadLasers], Source={StaticResource Localization}, Mode=OneWay}" Checked="OnEffectChanged" Unchecked="OnEffectChanged" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Grid.Column="1" Header="{Binding [Map], Source={StaticResource Localization}, Mode=OneWay}">
                            <StackPanel>
                                <CheckBox x:Name="MapInput" Content="{Binding [RevealMap], Source={StaticResource Localization}, Mode=OneWay}" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                <TextBlock x:Name="MapInfo" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0" Text="{Binding [MapTip], Source={StaticResource Localization}, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <!-- https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/how-to-use-the-image-element -->
                        <Image Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="12" Stretch="Fill" Height="103" Width="574" HorizontalAlignment="Right" VerticalAlignment="Bottom" ImageFailed="Image_ImageFailed">
                            <Image.Source>
                                <!-- To save significant application memory, set the DecodePixelWidth or  
                                DecodePixelHeight of the BitmapImage value of the image source to the desired 
                                height and width of the rendered image. If you don't do this, the application will 
                                cache the image as though it were rendered as its normal size rather than just 
                                the size that is displayed. -->
                                <!-- Note: In order to preserve aspect ratio, only set either DecodePixelWidth
                                or DecodePixelHeight but not both. -->
                                <BitmapImage DecodePixelHeight="103" UriSource="SETUP.BMP" />
                            </Image.Source>
                        </Image>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PrimaryTab" Header="{Binding [PrimaryTab], Source={StaticResource Localization}, Mode=OneWay}" IsEnabled="False">
                <ContentControl x:Name="PrimaryWeaponEditor" ContentTemplate="{StaticResource WeaponTabTemplate}" />
            </TabItem>
            <TabItem x:Name="SecondaryTab" Header="{Binding [SecondaryTab], Source={StaticResource Localization}, Mode=OneWay}" IsEnabled="False">
                <ContentControl x:Name="SecondaryWeaponEditor" ContentTemplate="{StaticResource WeaponTabTemplate}" />
            </TabItem>
            <TabItem x:Name="CountermeasureTab" Header="{Binding [CountermeasureTab], Source={StaticResource Localization}, Mode=OneWay}" IsEnabled="False">
                <ContentControl x:Name="CountermeasureEditor" ContentTemplate="{StaticResource WeaponTabTemplate}" />
            </TabItem>

            <TabItem x:Name="InventoryTab" Header="{Binding [InventoryTab], Source={StaticResource Localization}, Mode=OneWay}" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Header="{Binding [Items], Source={StaticResource Localization}, Mode=OneWay}">
                            <ItemsControl x:Name="CargoInputs" ItemTemplate="{StaticResource SupplyRowTemplate}" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="{Binding [ShipPermissions], Source={StaticResource Localization}, Mode=OneWay}">
                            <StackPanel>
                                <ItemsControl x:Name="ShipInputs" ItemTemplate="{StaticResource ShipRowTemplate}" />
                                <CheckBox x:Name="BlackPyroUnlockInput" Checked="OnInputChanged" Unchecked="OnInputChanged"
                                          ToolTip="{Binding [ShipPermissionTip], Source={StaticResource Localization}, Mode=OneWay}" />
                                <Button x:Name="PreferBlackPyroButton" Content="{Binding [BlackPyroOnly], Source={StaticResource Localization}, Mode=OneWay}"
                                        HorizontalAlignment="Left" Margin="0,8,0,4" Click="OnPreferBlackPyro" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding [BlackPyroHint], Source={StaticResource Localization}, Mode=OneWay}" />
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                                   Text="{Binding [CargoHint], Source={StaticResource Localization}, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="{Binding [SavedEntries], Source={StaticResource Localization}, Mode=OneWay}">
                            <ListBox x:Name="SavedInventory" MinHeight="110" MaxHeight="220"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GuideBotTab" Header="Guide-Bot" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="GuideBotInfo" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid x:Name="GuideBotEditor">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="{Binding [Properties], Source={StaticResource Localization}, Mode=OneWay}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <Label Style="{StaticResource ValueLabel}" Content="Name" Target="{Binding ElementName=GuideBotName}" />
                                        <TextBox x:Name="GuideBotName" MinWidth="105" VerticalContentAlignment="Center" MaxLength="7" TextChanged="OnInputChanged" />
                                    </DockPanel>
                                    <CheckBox x:Name="GuideBotChatter" Content="{Binding [BotChatter], Source={StaticResource Localization}, Mode=OneWay}" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                    <TextBlock x:Name="GuideBotShield" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="{Binding [BotSupplies], Source={StaticResource Localization}, Mode=OneWay}">
                                <ItemsControl x:Name="GuideBotSupplies">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <TextBox x:Name="GuideBotCount" DockPanel.Dock="Right" Width="74" Style="{StaticResource NumericInput}"
                                                         Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                                                <Label Style="{StaticResource ValueLabel}" Content="{Binding Name}" Target="{Binding ElementName=GuideBotCount}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding [ChangesTab], Source={StaticResource Localization}, Mode=OneWay}">
                <DockPanel Margin="12">
                    <Button x:Name="ReviewButton" DockPanel.Dock="Top" HorizontalAlignment="Left" IsEnabled="False"
                            Content="{Binding [CheckChanges], Source={StaticResource Localization}, Mode=OneWay}" Click="OnCheckChanges" />
                    <TextBox x:Name="Review" Margin="0,6,0,0" IsReadOnly="True"
                             FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Text="{Binding [ReviewHint], Source={StaticResource Localization}, Mode=OneWay}" />
                </DockPanel>
            </TabItem>
            <TabItem x:Name="HelpTab" Header="{Binding [HelpTab], Source={StaticResource Localization}, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="{Binding [HelpSaves], Source={StaticResource Localization}, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{Binding [HelpOpen], Source={StaticResource Localization}, Mode=OneWay}" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding [HelpBackups], Source={StaticResource Localization}, Mode=OneWay}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{Binding [HelpLoadout], Source={StaticResource Localization}, Mode=OneWay}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding [HelpLimits], Source={StaticResource Localization}, Mode=OneWay}" />
                        </GroupBox>
                        <GroupBox Header="{Binding [HelpEffects], Source={StaticResource Localization}, Mode=OneWay}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding [HelpTimers], Source={StaticResource Localization}, Mode=OneWay}" />
                        </GroupBox>
                        <GroupBox Header="{Binding [HelpShipsAndBot], Source={StaticResource Localization}, Mode=OneWay}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding [HelpPyroAndBot], Source={StaticResource Localization}, Mode=OneWay}" />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="Status" Grid.Row="3" Margin="0,8,0,0" Foreground="#465B70"
                   Text="{Binding [Ready], Source={StaticResource Localization}, Mode=OneWay}" TextWrapping="Wrap" />
    </Grid>
</Window>
