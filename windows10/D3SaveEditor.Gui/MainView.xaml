<Window x:Class="D3SaveEditor.Gui.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descent 3 · Savegame Editor" Width="920" Height="760"
        MinWidth="900" MinHeight="760" WindowStartupLocation="CenterScreen"
        Background="#F3F6FA" Foreground="#152438" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="NumericInput" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,2,8,4" />
        </Style>

        <DataTemplate x:Key="WeaponRowTemplate">
            <Grid Margin="0,2" MinHeight="29">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="154" />
                </Grid.ColumnDefinitions>
                <CheckBox HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                          IsChecked="{Binding Owned, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                <TextBox Grid.Column="2" Style="{StaticResource NumericInput}"
                         AutomationProperties.Name="{Binding AmmoLabel}"
                         IsEnabled="{Binding CanEditAmmo}" Text="{Binding Ammo, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3" Content="Max" IsEnabled="{Binding CanEditAmmo}" Click="OnMaxWeapon" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="6,0" Text="{Binding Limit}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WeaponTabTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <Label Style="{StaticResource ValueLabel}" Content="{Binding ActiveLabel}"
                               Target="{Binding ElementName=ActiveWeapon}" />
                        <ComboBox x:Name="ActiveWeapon" MinWidth="230" ItemsSource="{Binding Choices}"
                                  SelectedIndex="{Binding SelectedIndex, Mode=OneWay}"
                                  SelectionChanged="OnActiveWeaponChanged" />
                    </DockPanel>
                    <Grid Background="#E8EEF6" MinHeight="28" Margin="0,0,0,4" TextBlock.FontWeight="SemiBold">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="154" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Vorhanden" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding NameHeading}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CountHeading}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="6,0" Text="{Binding LimitHeading}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource WeaponRowTemplate}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Alle auswählen" Click="OnSelectWeapons" />
                        <Button Content="Alle abwählen" Click="OnClearWeapons" />
                        <Button Content="{Binding MaxPresentLabel}" Click="OnMaxShipWeapons" />
                        <Button Content="Vorhandene: 65.535" Click="OnMaxStorageWeapons" Visibility="{Binding StorageMaximumVisibility}" />
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Hint}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ExtraEntries}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate x:Key="SupplyRowTemplate">
            <DockPanel Margin="0,1">
                <TextBox x:Name="SupplyCount" DockPanel.Dock="Right" Width="74" Margin="4,0,0,4"
                         Style="{StaticResource NumericInput}" ToolTip="{Binding Hint}"
                         IsEnabled="{Binding CanEdit}" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                <Label Style="{StaticResource ValueLabel}" Content="{Binding Item.Name}"
                       Target="{Binding ElementName=SupplyCount}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShipRowTemplate">
            <CheckBox Content="{Binding Label}" IsEnabled="{Binding CanUnlock}"
                      IsChecked="{Binding Allowed, Mode=TwoWay}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,6">
            <Button Content="Spielstand öffnen…" Click="OnChooseOpen" />
            <Button x:Name="SaveButton" Content="Speichern + Backup" Click="OnSave" IsEnabled="False" />
            <Button x:Name="CopyButton" Content="Kopie speichern…" Click="OnSaveCopy" IsEnabled="False" />
            <Button x:Name="ResetButton" Content="Originalwerte" Click="OnReset" IsEnabled="False" />
            <Button Content="Schiffslimits laden…" Click="OnLoadLimits"
                    ToolTip="Liest die normalen Munitionsgrenzen für die Waffenreiter aus Table.gam, d3.hog oder einem Missionsarchiv." />
            <Button Content="Hilfe" Click="OnHelp" />
        </WrapPanel>

        <Border Grid.Row="1" Background="#152438" Padding="12,9" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="SaveTitle" Text="Noch kein Spielstand geöffnet"
                           FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SaveDetails" Margin="0,3,0,0" Foreground="#CFDCEA"
                           Text="Im Spiel speichern, dann eine Datei wie saveg000 aus dem Ordner savegame öffnen."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" x:Name="ZweiZeilenMesser" >
            <!--<Image Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Source="flashmen_1.jpg" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Center" ImageFailed="Image_ImageFailed" />-->
            <Image Height="{Binding ActualHeight, ElementName=ZweiZeilenMesser}" HorizontalAlignment="Right" VerticalAlignment="Center" ImageFailed="Image_ImageFailed" Stretch="Uniform">
                <Image.Source>
                    <!-- To save significant application memory, set the DecodePixelWidth or  
                    DecodePixelHeight of the BitmapImage value of the image source to the desired 
                    height and width of the rendered image. If you don't do this, the application will 
                    cache the image as though it were rendered as its normal size rather than just 
                    the size that is displayed. -->
                    <!-- Note: In order to preserve aspect ratio, only set either DecodePixelWidth
                    or DecodePixelHeight but not both. -->
                    <BitmapImage DecodePixelWidth="200" UriSource="flashmen_1.jpg" />
                </Image.Source>
            </Image>
        </DockPanel>

        <TabControl x:Name="EditorTabs" Grid.Row="2">
            <TabItem Header="Spieler / Ausrüstung">
                <ScrollViewer x:Name="PlayerEditor" IsEnabled="False" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Header="Versorgung">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Style="{StaticResource ValueLabel}" Content="Energie" Target="{Binding ElementName=EnergyInput}" />
                                <TextBox x:Name="EnergyInput" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Button Grid.Column="2" Content="Max 200" Click="OnMaxEnergy" />
                                <Label Grid.Row="1" Style="{StaticResource ValueLabel}" Content="Schild" Target="{Binding ElementName=ShieldsInput}" />
                                <TextBox x:Name="ShieldsInput" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Max 200" Click="OnMaxShields" />
                                <Label Grid.Row="2" Style="{StaticResource ValueLabel}" Content="Nachbrenner (s)" Target="{Binding ElementName=AfterburnerInput}" />
                                <TextBox x:Name="AfterburnerInput" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Button Grid.Row="2" Grid.Column="2" Content="Voll (5 s)" Click="OnMaxAfterburner" />
                                <Label Grid.Row="3" Style="{StaticResource ValueLabel}" Content="Leben" Target="{Binding ElementName=LivesInput}" />
                                <TextBox x:Name="LivesInput" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                                <Label Grid.Row="4" Style="{StaticResource ValueLabel}" Content="Punktestand" Target="{Binding ElementName=ScoreInput}" />
                                <TextBox x:Name="ScoreInput" Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericInput}" TextChanged="OnInputChanged" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Effekte">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="GodRenewButton" DockPanel.Dock="Right" Content="Verlängern" Click="OnRenewEffect" Tag="{Binding ElementName=GodModeInput}"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="Setzt die Restdauer des aktiven Effekts beim Speichern auf 1.000.000.000 s." />
                                    <CheckBox x:Name="GodModeInput" Content="God-Mode / unverwundbar"
                                              Checked="OnEffectChanged" Unchecked="OnEffectChanged"
                                              ToolTip="Schaltet die Unverwundbarkeit ein oder aus." />
                                </DockPanel>
                                <TextBlock x:Name="GodTime" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <DockPanel>
                                    <Button x:Name="CloakRenewButton" DockPanel.Dock="Right" Content="Verlängern" Click="OnRenewEffect" Tag="{Binding ElementName=CloakInput}"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="Setzt die Restdauer des aktiven Effekts beim Speichern auf 1.000.000.000 s." />
                                    <CheckBox x:Name="CloakInput" Content="Cloaked-Mode / getarnt" Checked="OnEffectChanged" Unchecked="OnEffectChanged"
                                              ToolTip="Tarnung wird am Spielerobjekt gesetzt. Fade-Übergänge werden beim Ändern beendet." />
                                </DockPanel>
                                <TextBlock x:Name="CloakTime" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="Ausrüstung">
                            <StackPanel>
                                <CheckBox x:Name="CoolerInput" Content="Nachbrenner-Kühler" Checked="OnEffectChanged" Unchecked="OnEffectChanged" />
                                <CheckBox x:Name="ConverterInput" Content="Energie → Schild-Konverter" Checked="OnEffectChanged" Unchecked="OnEffectChanged" />
                                <CheckBox x:Name="QuadInput" Content="Quad-Laser" Checked="OnEffectChanged" Unchecked="OnEffectChanged" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Grid.Column="1" Header="Karte">
                            <StackPanel>
                                <CheckBox x:Name="MapInput" Content="Gesamte Karte aufdecken" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                <TextBlock x:Name="MapInfo" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0" Text="Ohne Häkchen bleibt die gespeicherte Erkundung erhalten."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <!-- https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/how-to-use-the-image-element -->
                        <Image Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="12" Stretch="Fill" Height="103" Width="574" HorizontalAlignment="Right" VerticalAlignment="Bottom" ImageFailed="Image_ImageFailed">
                            <Image.Source>
                                <!-- To save significant application memory, set the DecodePixelWidth or  
                                DecodePixelHeight of the BitmapImage value of the image source to the desired 
                                height and width of the rendered image. If you don't do this, the application will 
                                cache the image as though it were rendered as its normal size rather than just 
                                the size that is displayed. -->
                                <!-- Note: In order to preserve aspect ratio, only set either DecodePixelWidth
                                or DecodePixelHeight but not both. -->
                                <BitmapImage DecodePixelHeight="103" UriSource="SETUP.BMP" />
                            </Image.Source>
                        </Image>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PrimaryTab" Header="Primärwaffen" IsEnabled="False">
                <ContentControl x:Name="PrimaryWeaponEditor" ContentTemplate="{StaticResource WeaponTabTemplate}" />
            </TabItem>
            <TabItem x:Name="SecondaryTab" Header="Sekundärwaffen" IsEnabled="False">
                <ContentControl x:Name="SecondaryWeaponEditor" ContentTemplate="{StaticResource WeaponTabTemplate}" />
            </TabItem>
            <TabItem x:Name="CountermeasureTab" Header="Gegenmaßnahmen" IsEnabled="False">
                <ContentControl x:Name="CountermeasureEditor" ContentTemplate="{StaticResource WeaponTabTemplate}" />
            </TabItem>

            <TabItem x:Name="InventoryTab" Header="Inventar / Schiffe" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Header="Gegenstände">
                            <ItemsControl x:Name="CargoInputs" ItemTemplate="{StaticResource SupplyRowTemplate}" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Schiffsfreigaben">
                            <StackPanel>
                                <ItemsControl x:Name="ShipInputs" ItemTemplate="{StaticResource ShipRowTemplate}" />
                                <CheckBox x:Name="BlackPyroUnlockInput" Checked="OnInputChanged" Unchecked="OnInputChanged"
                                          ToolTip="Speichert die Freigabe im Spielstand." />
                                <Button x:Name="PreferBlackPyroButton" Content="Nur Black Pyro erlauben"
                                        HorizontalAlignment="Left" Margin="0,8,0,4" Click="OnPreferBlackPyro" />
                                <TextBlock TextWrapping="Wrap" Text="Der Knopf wählt alle anderen Schiffe ab. Da der Black Pyro im Auswahlmenü fehlt, übernimmt ihn das Spiel als einziges erlaubtes Schiff beim nächsten passenden Briefing automatisch. Das funktioniert auch in der Hauptkampagne." />
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                                   Text="0 entfernt den Eintrag. Kühler, Konverter und Quad-Laser stehen im Spieler-Tab."
                                   TextWrapping="Wrap" />
                        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Gespeicherte Einträge">
                            <ListBox x:Name="SavedInventory" MinHeight="110" MaxHeight="220"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GuideBotTab" Header="Guide-Bot" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="GuideBotInfo" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid x:Name="GuideBotEditor">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="Eigenschaften">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <Label Style="{StaticResource ValueLabel}" Content="Name" Target="{Binding ElementName=GuideBotName}" />
                                        <TextBox x:Name="GuideBotName" MinWidth="105" VerticalContentAlignment="Center" MaxLength="7" TextChanged="OnInputChanged" />
                                    </DockPanel>
                                    <CheckBox x:Name="GuideBotChatter" Content="Regelmäßige Funkmeldungen" Checked="OnInputChanged" Unchecked="OnInputChanged" />
                                    <TextBlock x:Name="GuideBotShield" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="Vorräte">
                                <ItemsControl x:Name="GuideBotSupplies">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <TextBox x:Name="GuideBotCount" DockPanel.Dock="Right" Width="74" Style="{StaticResource NumericInput}"
                                                         Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                                                <Label Style="{StaticResource ValueLabel}" Content="{Binding Name}" Target="{Binding ElementName=GuideBotCount}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Datei / Änderungen">
                <DockPanel Margin="12">
                    <Button x:Name="ReviewButton" DockPanel.Dock="Top" HorizontalAlignment="Left" IsEnabled="False"
                            Content="Änderungen prüfen" Click="OnCheckChanges" />
                    <TextBox x:Name="Review" Margin="0,6,0,0" IsReadOnly="True"
                             FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Text="Hier erscheinen die Dateianalyse und die geplanten Änderungen." />
                </DockPanel>
            </TabItem>
            <TabItem x:Name="HelpTab" Header="Hilfe">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="Spielstände öffnen und speichern">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="Im Spiel speichern und das Spiel beenden. Danach eine Datei wie saveg000 aus dem Ordner savegame öffnen, Werte bearbeiten und den geänderten Spielstand im Spiel laden." />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Beim Überschreiben erstellt der Editor eine datierte Sicherung. Eine Kopie mit der Endung .edited zum Laden in einen passenden savegNNN-Slot umbenennen." />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Waffen und Gegenmaßnahmen">
                            <TextBlock TextWrapping="Wrap" Text="Schiffslimits laden liest normale Munitionsgrenzen aus Table.gam, d3.hog oder einem Missionsarchiv. Vorhandene: Schiffslimit nutzt diese Werte für die Waffen. Bei Gegenmaßnahmen gelten die angezeigten Spiellimits für alle Schiffe." />
                        </GroupBox>
                        <GroupBox Header="Unverwundbarkeit und Tarnung">
                            <TextBlock TextWrapping="Wrap" Text="Das Häkchen schaltet den Effekt ein oder aus. Verlängern setzt die Restdauer eines bereits aktiven Effekts beim Speichern auf 1.000.000.000 Sekunden." />
                        </GroupBox>
                        <GroupBox Header="Black Pyro und Guide-Bot">
                            <TextBlock TextWrapping="Wrap" Text="Nur Black Pyro erlauben wählt alle anderen Schiffe ab, damit das Spiel beim nächsten passenden Briefing den Black Pyro übernimmt. Der Reiter Guide-Bot bearbeitet Name, Funkmeldungen und Vorräte des gespeicherten Roboters, wenn der Skriptzustand eindeutig erkannt wurde." />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="Status" Grid.Row="3" Margin="0,8,0,0" Foreground="#465B70"
                   Text="Bereit · Dateien können auch in das Fenster gezogen werden." TextWrapping="Wrap" />
    </Grid>
</Window>
