#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION D3_VERSION_COMPONENTS
    PRODUCTVERSION D3_VERSION_COMPONENTS
    FILEOS VOS__WINDOWS32
    FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription", "Descent 3 Savegame Editor for Windows 98"
            VALUE "FileVersion", D3_VERSION_TEXT
            VALUE "OriginalFilename", "D3EDIT98.EXE"
            VALUE "ProductName", "Descent 3 Savegame Editor"
            VALUE "ProductVersion", D3_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
